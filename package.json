{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "dev": "cp app-config.local-dev.yaml app-config.local.yaml && NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/aegis-local-trust.pem} backstage-cli repo start",
    "dev:cloud": "cp app-config.cloud.yaml app-config.local.yaml && NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/aegis-local-trust.pem} backstage-cli repo start",
    "dev:cloud-tls": "cp app-config.cloud-tls.yaml app-config.local.yaml && NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/aegis-local-trust.pem} backstage-cli repo start",
    "start": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-$HOME/aegis-local-trust.pem} backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.4-next.0",
    "@backstage/e2e-test-utils": "^0.1.1",
    "@playwright/test": "^1.32.3",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tar": "^7.5.13",
    "undici": "^6.24.0",
    "elliptic": "^6.6.1",
    "react-router": "^6.30.2",
    "@remix-run/router": "^1.23.2",
    "qs": "^6.14.2",
    "jws": "^4.0.1",
    "node-forge": "^1.3.2",
    "glob": "^9.3.5",
    "js-yaml": "^4.1.1",
    "koa": "^2.16.4",
    "prismjs": "^1.30.0",
    "cookie": "^1.0.2",
    "diff": "^8.0.3",
    "test-exclude": "^6.0.0",
    "flatted": "^3.4.2",
    "basic-ftp": "^5.2.0",
    "dompurify": "^3.3.2",
    "multer": "^2.1.1",
    "underscore": "^1.13.8",
    "immutable": "^3.8.3",
    "svgo": "^2.8.1",
    "rollup": "^4.59.0",
    "file-type": "^21.3.1",
    "markdown-it": "^14.1.1",
    "@tootallnate/once": "^3.0.1",
    "@backstage/cli-common": "^0.1.17",
    "@backstage/integration": "^1.20.1",
    "@backstage/plugin-auth-backend": "^0.27.1",
    "@smithy/config-resolver": "^4.4.0",
    "minimatch@npm:3.1.2": "3.1.5",
    "minimatch@npm:^3.0.4": "3.1.5",
    "minimatch@npm:^3.0.5": "3.1.5",
    "minimatch@npm:^3.1.2": "3.1.5",
    "minimatch@npm:^5.0.0": "5.1.8",
    "minimatch@npm:^5.1.0": "5.1.8",
    "minimatch@npm:^5.1.6": "5.1.8",
    "minimatch@npm:^7.0.0": "7.4.8",
    "minimatch@npm:^7.4.2": "7.4.8",
    "minimatch@npm:^7.4.6": "7.4.8",
    "minimatch@npm:^8.0.0": "8.0.6",
    "minimatch@npm:^8.0.2": "8.0.6",
    "minimatch@npm:^8.0.4": "8.0.6",
    "minimatch@npm:^9.0.0": "9.0.9",
    "minimatch@npm:^9.0.4": "9.0.9",
    "minimatch@npm:^9.0.5": "9.0.9",
    "@octokit/plugin-paginate-rest": "^9.2.2",
    "@backstage/plugin-techdocs-node@npm:1.13.8-next.0": "1.14.4",
    "fast-xml-parser@npm:^4.4.1": "4.5.4",
    "fast-xml-parser@npm:^4.5.0": "4.5.4",
    "fast-xml-parser@npm:^5.0.7": "5.5.7",
    "fast-xml-parser@npm:5.2.5": "5.5.7",
    "@backstage/backend-app-api": "^1.5.0",
    "@backstage/backend-plugin-api": "^1.8.0"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1"
}
