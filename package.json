{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "dev": "cp app-config.local-dev.yaml app-config.local.yaml && backstage-cli repo start",
    "dev:cloud": "cp app-config.cloud.yaml app-config.local.yaml && backstage-cli repo start",
    "dev:cloud-tls": "cp app-config.cloud-tls.yaml app-config.local.yaml && backstage-cli repo start",
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/*"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.4-next.0",
    "@backstage/e2e-test-utils": "^0.1.1",
    "@playwright/test": "^1.32.3",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tar": "^7.5.3",
    "undici": "^6.21.1",
    "elliptic": "^6.6.1",
    "react-router": "^6.30.2",
    "@remix-run/router": "^1.23.2",
    "qs": "^6.14.0",
    "jws": "^4.0.0",
    "node-forge": "^1.3.1",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "koa": "^2.16.0",
    "prismjs": "^1.30.0",
    "cookie": "^1.0.2",
    "diff": "^7.0.0",
    "test-exclude": "^7.0.1"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1"
}
